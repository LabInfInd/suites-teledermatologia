# Generare .env con: python3 scripts/configure_vm.py
POSTGRES_PASSWORD=
# Prima prova sulla VM, accessibile dal PC tramite tunnel SSH.
HOST_BIND=127.0.0.1
APP_PORT=8001
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
HTTP_DEMO_ORIGINS=
# Prova HTTP sull'inoltro istituzionale, da attivare esplicitamente nella VM:
# HOST_BIND=192.168.50.10
# APP_PORT=8000
# APP_ORIGINS=http://10.50.3.17
# HTTP_DEMO_ORIGINS=http://10.50.3.17
# Per consentire anche il precedente indirizzo pubblico durante le prove:
# APP_ORIGINS=http://10.50.3.17,http://193.204.50.163
# HTTP_DEMO_ORIGINS=http://10.50.3.17,http://193.204.50.163
SESSION_HOURS=8
MODEL_ADAPTER=disabled
MODEL_THREADS=4
